{
  // src/index.ts compiles into lib/, beside the loader napi generates (lib/binding.js). rootDirs lets the
  // source import './binding.js' as if it already sat there.
  "compilerOptions": {
    "target": "ES2022",
    // isWellFormed and ArrayBuffer.detached are ES2024; Node 22 has both.
    "lib": ["ES2022", "ES2024.String", "ES2024.ArrayBuffer"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "rootDirs": ["src", "lib"],
    "outDir": "lib",
    "declaration": true,
    "stripInternal": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "newLine": "lf"
  },
  "include": ["src"]
}
